#!/bin/bash
set -e
export DEBIAN_FRONTEND=noninteractive
until apt-get update -y; do sleep 5; done
apt-get install -y wireguard

# Routing between the tunnel and the VPC
echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-wireguard.conf
sysctl -p /etc/sysctl.d/99-wireguard.conf

# Private key from SSM Parameter Store, so the key (and pfSense's peer
# config) survives a rebuild of this instance
snap install aws-cli --classic
umask 077
/snap/bin/aws ssm get-parameter --region eu-central-1 \
  --name /cs2/wireguard/vpn01-private-key --with-decryption \
  --query Parameter.Value --output text > /etc/wireguard/privatekey
wg pubkey < /etc/wireguard/privatekey > /etc/wireguard/publickey

cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address    = 172.16.255.2/30
ListenPort = 51820
PrivateKey = $(cat /etc/wireguard/privatekey)

[Peer]
# pfSense cs2-fw01 (Educloud) - behind school NAT, so no Endpoint here
PublicKey  = ${pfsense_pubkey}
AllowedIPs = ${onprem_cidr}
EOF

systemctl enable --now wg-quick@wg0
